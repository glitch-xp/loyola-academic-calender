{
  "expo": {
    "name": "Loyola Time Table App",
    "slug": "loyola-timetable-app",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loyola",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/50c8e57e-5092-45df-b5b2-075dd98f4511"
    },
    "runtimeVersion": "2.1.1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loyola.timetableapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "name": "Loyola Time Table",
      "baseUrl": "/",
      "shortName": "Loyola",
      "display": "standalone",
      "backgroundColor": "#003366",
      "themeColor": "#003366",
      "description": "Loyola College Academic Calendar and Time Table App"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#003366"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/"
    },
    "android": {
      "package": "com.loyola.timetableapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#003366"
      }
    },
    "extra": {
      "eas": {
        "projectId": "50c8e57e-5092-45df-b5b2-075dd98f4511"
      }
    },
    "owner": "glitch_xp"
  }
}
